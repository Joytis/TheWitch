<Project>
    <!--
      Fills Sts2Path and Sts2DataDir when not set (e.g. no local.props).
      Override via local.props or MSBuild /p:Sts2Path=...

      Limitation: only the primary Steam library is scanned (registry + default path);
      secondary libraries (libraryfolders.vdf) are not parsed. If the game lives in one,
      set Sts2Path in local.props.
    -->
    <!--
      Game branch selection (single source, two game versions). /p:Sts2Branch=public|beta (tools:
      -Branch) picks the install to compile against and deploy into:
          1. local.props <Sts2PublicPath> / <Sts2BetaPath>, else
          2. the repo's cached copy game-installs/<branch>/ (tools/setup-game-install.ps1), else
          3. public only: the Steam install (auto-discovery below).
      beta also defines STS2_BETA, so API differences live behind #if STS2_BETA in one source tree.
      A beta build with no install gets a path that cannot exist, so it fails in
      CheckDependencyPaths instead of silently compiling against the Steam install.
      No Sts2Branch at all = the Steam install, no define (plain `dotnet build`, as always).
    -->
    <PropertyGroup>
        <Sts2InstallsDir>$(MSBuildThisFileDirectory)game-installs/</Sts2InstallsDir>
        <Sts2PublicPath Condition="'$(Sts2PublicPath)' == '' and Exists('$(Sts2InstallsDir)public/SlayTheSpire2.exe')">$(Sts2InstallsDir)public</Sts2PublicPath>
        <Sts2BetaPath Condition="'$(Sts2BetaPath)' == '' and Exists('$(Sts2InstallsDir)beta/SlayTheSpire2.exe')">$(Sts2InstallsDir)beta</Sts2BetaPath>
        <Sts2Path Condition="'$(Sts2Branch)' == 'public' and '$(Sts2PublicPath)' != ''">$(Sts2PublicPath)</Sts2Path>
        <Sts2Path Condition="'$(Sts2Branch)' == 'beta'">$(Sts2BetaPath)</Sts2Path>
        <Sts2Path Condition="'$(Sts2Branch)' == 'beta' and '$(Sts2BetaPath)' == ''">no-beta-install--run-tools-setup-game-install.ps1</Sts2Path>
        <DefineConstants Condition="'$(Sts2Branch)' == 'beta'">$(DefineConstants);STS2_BETA</DefineConstants>
    </PropertyGroup>

    <!-- OS Detection -->
    <PropertyGroup>
        <IsLinux>false</IsLinux>
        <IsOSX>false</IsOSX>
        <IsLinux Condition="$([MSBuild]::IsOSPlatform('Linux'))">true</IsLinux>
        <IsOSX Condition="$([MSBuild]::IsOSPlatform('OSX'))">true</IsOSX>
    </PropertyGroup>

    <!-- Default -->
    <PropertyGroup Condition="'$(IsLinux)' != 'true' And '$(IsOSX)' != 'true'">
        <!-- Try getting uninstall location first -->
        <RegistrySts2Path>$([MSBuild]::GetRegistryValueFromView('HKEY_LOCAL_MACHINE\SOFTWARE\Microsoft\Windows\CurrentVersion\Uninstall\Steam App 2868840', 'InstallLocation', '', RegistryView.Registry64, RegistryView.Registry32))</RegistrySts2Path>
        <AutoSteamPath>$(registry:HKEY_CURRENT_USER\Software\Valve\Steam@SteamPath)\steamapps</AutoSteamPath>
        <SteamLibraryPath Condition="'$(SteamLibraryPath)' == '' and Exists('$(AutoSteamPath)/common/Slay the Spire 2')">$(AutoSteamPath)</SteamLibraryPath>
        <SteamLibraryPath Condition="'$(SteamLibraryPath)' == ''">C:/Program Files (x86)/Steam/steamapps</SteamLibraryPath>

        <Sts2Path Condition="'$(Sts2Path)' == '' and Exists('$(SteamLibraryPath)/common/Slay the Spire 2')">$(SteamLibraryPath)/common/Slay the Spire 2</Sts2Path>
        <Sts2Path Condition="'$(Sts2Path)' == '' and Exists('$(RegistrySts2Path)/data_sts2_windows_x86_64')">$(RegistrySts2Path)</Sts2Path>
        <Sts2Path Condition="'$(Sts2Path)' == ''">$(SteamLibraryPath)/common/Slay the Spire 2</Sts2Path>

        <ModsPath>$(Sts2Path)/mods/</ModsPath>
        <Sts2DataDir>$(Sts2Path)/data_sts2_windows_x86_64</Sts2DataDir>
    </PropertyGroup>

    <!-- Linux -->
    <PropertyGroup Condition="'$(IsLinux)' == 'true'">
        <SteamLibraryPath Condition="'$(SteamLibraryPath)' == ''">$(HOME)/.local/share/Steam/steamapps</SteamLibraryPath>
        <Sts2Path Condition="'$(Sts2Path)' == ''">$(SteamLibraryPath)/common/Slay the Spire 2</Sts2Path>

        <ModsPath>$(Sts2Path)/mods/</ModsPath>
        <Sts2DataDir>$(Sts2Path)/data_sts2_linuxbsd_x86_64</Sts2DataDir>
    </PropertyGroup>

    <!-- macOS -->
    <PropertyGroup Condition="'$(IsOSX)' == 'true'">
        <SteamLibraryPath Condition="'$(SteamLibraryPath)' == ''">$(HOME)/Library/Application Support/Steam/steamapps</SteamLibraryPath>
        <Sts2Path Condition="'$(Sts2Path)' == ''">$(SteamLibraryPath)/common/Slay the Spire 2</Sts2Path>

        <ModsPath>$(Sts2Path)/SlayTheSpire2.app/Contents/MacOS/mods/</ModsPath>
        <Sts2DataDir>$(Sts2Path)/SlayTheSpire2.app/Contents/Resources/data_sts2_macos_x86_64</Sts2DataDir>
    </PropertyGroup>
</Project>
