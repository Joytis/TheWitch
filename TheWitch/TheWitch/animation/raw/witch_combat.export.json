{
"class": "export-binary",
"name": "Binary",
"extension": ".skel",
"nonessential": false,
"cleanUp": true,
"warnings": true,
"open": false,
"packSource": "attachments",
"packTarget": "perskeleton",
"packAtlas": {
	"premultiplyAlpha": false,
	"bleed": true,
	"scale": [ 0.2 ],
	"scaleSuffix": [ "" ],
	"scaleResampling": [ "bicubic" ],
	"maxWidth": 2048,
	"maxHeight": 2048,
	"pot": false,
	"multipleOfFour": false,
	"square": false,
	"stripWhitespaceX": true,
	"stripWhitespaceY": true,
	"alphaThreshold": 3,
	"rotation": true,
	"alias": true,
	"ignoreBlankImages": false,
	"paddingX": 2,
	"paddingY": 2,
	"edgePadding": true,
	"duplicatePadding": false,
	"filterMin": "Linear",
	"filterMag": "Linear",
	"wrapX": "ClampToEdge",
	"wrapY": "ClampToEdge",
	"format": "RGBA8888",
	"outputFormat": "png",
	"atlasExtension": ".atlas",
	"combineSubdirectories": false,
	"flattenPaths": false,
	"useIndexes": false,
	"fast": false,
	"limitMemory": true,
	"packing": "rectangles",
	"prettyPrint": false,
	"legacyOutput": false,
	"debug": false
}
}
