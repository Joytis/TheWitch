{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Run",
            "type": "process",
            "command": "powershell",
            "args": [
                "-NoProfile",
                "-ExecutionPolicy",
                "Bypass",
                "-Command",
                "& '${workspaceFolder}/tools/launch.ps1' -Character ${input:character} -Solo -TailLog -DelayMs 4000 -Build ${input:build.publish}"
            ],
            "isBackground": true,
            "problemMatcher": {
                "owner": "sts2",
                "pattern": [
                    {
                        "regexp": ".",
                        "file": 1,
                        "location": 2,
                        "message": 3
                    }
                ],
                "background": {
                    "activeOnStart": true,
                    "beginsPattern": ".",
                    "endsPattern": "Launched 1 solo instance"
                }
            },
            "presentation": {
                "reveal": "always",
                "panel": "shared",
                "clear": true
            },
            "detail": "Launch one STS2 instance, tailing the game log. Prompts for the build step (None / Build / Publish; default Publish). Debugger-attachable via 'Launch STS2 + Attach'. Prompts for the character mod (Witch / Augur)."
        },
        {
            "label": "Run: Reset Witch Tutorials",
            "type": "process",
            "command": "powershell",
            "args": [
                "-NoProfile",
                "-ExecutionPolicy",
                "Bypass",
                "-Command",
                "& '${workspaceFolder}/tools/launch.ps1' -Character ${input:character} -Solo -ResetFtue -TailLog -DelayMs 4000 -Build ${input:build.publish}"
            ],
            "isBackground": true,
            "problemMatcher": {
                "owner": "sts2",
                "pattern": [
                    {
                        "regexp": ".",
                        "file": 1,
                        "location": 2,
                        "message": 3
                    }
                ],
                "background": {
                    "activeOnStart": true,
                    "beginsPattern": ".",
                    "endsPattern": "Launched 1 solo instance"
                }
            },
            "presentation": {
                "reveal": "always",
                "panel": "shared",
                "clear": true
            },
            "detail": "Like Run, but passes -witch-reset-ftue: at the main menu, forgets every Witch tutorial tip (e.g. the Unstable potion tip) and re-enables tutorials so they show again. Base-game tutorials untouched. Prompts for the character mod (Witch / Augur)."
        },
        {
            "label": "MP: Launch",
            "type": "process",
            "command": "powershell",
            "args": [
                "-NoProfile",
                "-ExecutionPolicy",
                "Bypass",
                "-Command",
                "& '${workspaceFolder}/tools/launch.ps1' -Character ${input:character} -Players ${input:playerCount} -Build ${input:build.none}"
            ],
            "problemMatcher": [],
            "presentation": {
                "reveal": "always",
                "panel": "shared",
                "clear": true
            },
            "detail": "Launch a host + (N-1) clients for local multiplayer. Prompts for player count and build step (default None). Prompts for the character mod (Witch / Augur)."
        },
        {
            "label": "Debug: Combat",
            "type": "process",
            "command": "powershell",
            "args": [
                "-NoProfile",
                "-ExecutionPolicy",
                "Bypass",
                "-Command",
                "& '${workspaceFolder}/tools/launch.ps1' -Character ${input:character} -Solo -Bootstrap -TailLog -DelayMs 4000 -Build ${input:build.publish}"
            ],
            "isBackground": true,
            "problemMatcher": {
                "owner": "sts2",
                "pattern": [
                    {
                        "regexp": ".",
                        "file": 1,
                        "location": 2,
                        "message": 3
                    }
                ],
                "background": {
                    "activeOnStart": true,
                    "beginsPattern": ".",
                    "endsPattern": "Launched 1 solo instance"
                }
            },
            "presentation": {
                "reveal": "always",
                "panel": "shared",
                "clear": true
            },
            "detail": "Launch STS2 straight into a combat as the chosen character with 100 energy, tailing the game log. Prompts for the build step (default Publish). Debugger-attachable via 'Combat + Attach'. Prompts for the character mod (Witch / Augur)."
        },
        {
            "label": "Debug: AutoSlay",
            "type": "process",
            "command": "powershell",
            "args": [
                "-NoProfile",
                "-ExecutionPolicy",
                "Bypass",
                "-Command",
                "& '${workspaceFolder}/tools/launch.ps1' -Character ${input:character} -Solo -AutoSlay -TailLog -DelayMs 4000 -Build ${input:build.build} ${input:headless.windowed}"
            ],
            "isBackground": true,
            "problemMatcher": {
                "owner": "sts2",
                "pattern": [
                    {
                        "regexp": ".",
                        "file": 1,
                        "location": 2,
                        "message": 3
                    }
                ],
                "background": {
                    "activeOnStart": true,
                    "beginsPattern": ".",
                    "endsPattern": "Launched 1 solo instance"
                }
            },
            "presentation": {
                "reveal": "always",
                "panel": "shared",
                "clear": true
            },
            "detail": "Launch STS2 with the AutoSlay smoke-test bot, tailing the game log. Prompts for the build step (default Build) and windowed vs headless. Debugger-attachable via 'AutoSlay + Attach'. Prompts for the character mod (Witch / Augur)."
        },
        {
            "label": "Debug: Card Test",
            "type": "process",
            "command": "powershell",
            "args": [
                "-NoProfile",
                "-ExecutionPolicy",
                "Bypass",
                "-Command",
                "& '${workspaceFolder}/tools/launch.ps1' -Character ${input:character} -Solo -CardTest -TailLog -DelayMs 4000 -Build ${input:build.build} ${input:headless.headless}"
            ],
            "isBackground": true,
            "problemMatcher": {
                "owner": "sts2",
                "pattern": [
                    {
                        "regexp": ".",
                        "file": 1,
                        "location": 2,
                        "message": 3
                    }
                ],
                "background": {
                    "activeOnStart": true,
                    "beginsPattern": ".",
                    "endsPattern": "Launched 1 solo instance"
                }
            },
            "presentation": {
                "reveal": "always",
                "panel": "shared",
                "clear": true
            },
            "detail": "Launch STS2 with --witch-cardtest: plays every Witch card in a throwaway test combat and logs [witch-cardtest] FAILED lines (grep the tailed log). Prompts for the build step (default Build) and windowed vs headless (default Headless). Prompts for the character mod (Witch / Augur)."
        },
        {
            "label": "Debug: Potion Test",
            "type": "process",
            "command": "powershell",
            "args": [
                "-NoProfile",
                "-ExecutionPolicy",
                "Bypass",
                "-Command",
                "& '${workspaceFolder}/tools/launch.ps1' -Character ${input:character} -Solo -PotionTest -TailLog -DelayMs 4000 -Build ${input:build.build} ${input:headless.headless}"
            ],
            "isBackground": true,
            "problemMatcher": {
                "owner": "sts2",
                "pattern": [
                    {
                        "regexp": ".",
                        "file": 1,
                        "location": 2,
                        "message": 3
                    }
                ],
                "background": {
                    "activeOnStart": true,
                    "beginsPattern": ".",
                    "endsPattern": "Launched 1 solo instance"
                }
            },
            "presentation": {
                "reveal": "always",
                "panel": "shared",
                "clear": true
            },
            "detail": "Launch STS2 with --witch-potiontest: procures, uses and discards every Witch potion in a throwaway test combat and logs [witch-potiontest] FAILED lines. Prompts for the build step (default Build) and windowed vs headless (default Headless). Prompts for the character mod (Witch / Augur)."
        },
        {
            "label": "Debug: Relic Test",
            "type": "process",
            "command": "powershell",
            "args": [
                "-NoProfile",
                "-ExecutionPolicy",
                "Bypass",
                "-Command",
                "& '${workspaceFolder}/tools/launch.ps1' -Character ${input:character} -Solo -RelicTest -TailLog -DelayMs 4000 -Build ${input:build.build} ${input:headless.headless}"
            ],
            "isBackground": true,
            "problemMatcher": {
                "owner": "sts2",
                "pattern": [
                    {
                        "regexp": ".",
                        "file": 1,
                        "location": 2,
                        "message": 3
                    }
                ],
                "background": {
                    "activeOnStart": true,
                    "beginsPattern": ".",
                    "endsPattern": "Launched 1 solo instance"
                }
            },
            "presentation": {
                "reveal": "always",
                "panel": "shared",
                "clear": true
            },
            "detail": "Launch STS2 with --witch-relictest: equips EVERY Witch relic, then plays every card and uses every potion in throwaway test combats and logs [witch-relictest] FAILED lines. Prompts for the build step (default Build) and windowed vs headless (default Headless). Prompts for the character mod (Witch / Augur)."
        },
        {
            "label": "Debug: Menu Test",
            "type": "process",
            "command": "powershell",
            "args": [
                "-NoProfile",
                "-ExecutionPolicy",
                "Bypass",
                "-Command",
                "& '${workspaceFolder}/tools/launch.ps1' -Character ${input:character} -Solo -MenuTest -TailLog -DelayMs 4000 -Build ${input:build.build} ${input:headless.headless}"
            ],
            "isBackground": true,
            "problemMatcher": {
                "owner": "sts2",
                "pattern": [
                    {
                        "regexp": ".",
                        "file": 1,
                        "location": 2,
                        "message": 3
                    }
                ],
                "background": {
                    "activeOnStart": true,
                    "beginsPattern": ".",
                    "endsPattern": "Launched 1 solo instance"
                }
            },
            "presentation": {
                "reveal": "always",
                "panel": "shared",
                "clear": true
            },
            "detail": "Launch STS2 with --witch-menutest: opens every main-menu screen (character select with the Witch picked, card library per pool tab, relic collection, potion lab, bestiary, stats, run history, timeline, settings, profile) and renders every Witch hover tip, logging [witch-menutest] FAILED lines. Prompts for the build step (default Build) and windowed vs headless (default Headless). Prompts for the character mod (Witch / Augur)."
        },
        {
            "label": "Debug: Test All",
            "type": "process",
            "command": "powershell",
            "args": [
                "-NoProfile",
                "-ExecutionPolicy",
                "Bypass",
                "-Command",
                "& '${workspaceFolder}/tools/launch.ps1' -Character ${input:character} -Solo -TestAll -TailLog -DelayMs 4000 -Build ${input:build.build} ${input:headless.headless}"
            ],
            "isBackground": true,
            "problemMatcher": {
                "owner": "sts2",
                "pattern": [
                    {
                        "regexp": ".",
                        "file": 1,
                        "location": 2,
                        "message": 3
                    }
                ],
                "background": {
                    "activeOnStart": true,
                    "beginsPattern": ".",
                    "endsPattern": "Launched 1 solo instance"
                }
            },
            "presentation": {
                "reveal": "always",
                "panel": "shared",
                "clear": true
            },
            "detail": "Launch STS2 with --witch-testall: runs the menu sweep, then the card, potion and relic smoke tests back to back in one process and logs [witch-testall] FAILED lines. Prompts for the build step (default Build) and windowed vs headless (default Headless). Prompts for the character mod (Witch / Augur)."
        },
        {
            "label": "Debug: FX Lab",
            "type": "process",
            "command": "powershell",
            "args": [
                "-NoProfile",
                "-ExecutionPolicy",
                "Bypass",
                "-Command",
                "& '${workspaceFolder}/tools/launch.ps1' -Character ${input:character} -Solo -FxLab -TailLog -DelayMs 4000 -Build ${input:build.build}"
            ],
            "isBackground": true,
            "problemMatcher": {
                "owner": "sts2",
                "pattern": [
                    {
                        "regexp": ".",
                        "file": 1,
                        "location": 2,
                        "message": 3
                    }
                ],
                "background": {
                    "activeOnStart": true,
                    "beginsPattern": ".",
                    "endsPattern": "Launched 1 solo instance"
                }
            },
            "presentation": {
                "reveal": "always",
                "panel": "shared",
                "clear": true
            },
            "detail": "Launch STS2 into the SFX/VFX browser scene, tailing the game log. Prompts for the build step (default Build). Debugger-attachable via 'FX Lab + Attach'. Prompts for the character mod (Witch / Augur)."
        },
        {
            "label": "Debug: FX Lab + Combat",
            "type": "process",
            "command": "powershell",
            "args": [
                "-NoProfile",
                "-ExecutionPolicy",
                "Bypass",
                "-Command",
                "& '${workspaceFolder}/tools/launch.ps1' -Character ${input:character} -Solo -FxLab -DelayMs 2000 -Build ${input:build.publish}; & '${workspaceFolder}/tools/launch.ps1' -Character ${input:character} -Solo -Bootstrap -TailLog -DelayMs 4000"
            ],
            "isBackground": true,
            "problemMatcher": {
                "owner": "sts2",
                "pattern": [
                    {
                        "regexp": ".",
                        "file": 1,
                        "location": 2,
                        "message": 3
                    }
                ],
                "background": {
                    "activeOnStart": true,
                    "beginsPattern": ".",
                    "endsPattern": "Launched 1 solo instance"
                }
            },
            "presentation": {
                "reveal": "always",
                "panel": "shared",
                "clear": true
            },
            "detail": "Launch TWO STS2 instances: FX Lab first, then Witch combat (tailing its log) — VFX iteration with a live combat reference. Prompts for the build step (default Publish; applied once, before the first launch). Prompts for the character mod (Witch / Augur)."
        },
        {
            "label": "Godot: Import assets",
            "type": "process",
            "command": "powershell",
            "args": [
                "-NoProfile",
                "-ExecutionPolicy",
                "Bypass",
                "-File",
                "${workspaceFolder}/tools/import-assets.ps1",
                "-Character",
                "${input:character}"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": [],
            "presentation": {
                "reveal": "always",
                "panel": "shared",
                "clear": true
            },
            "detail": "Headless Godot --import: generate .import sidecars for new pngs (card portraits, etc.). Prompts for the character mod."
        },
        {
            "label": "Images: Generate missing sizes",
            "type": "process",
            "command": "py",
            "args": [
                "${workspaceFolder}/tools/gen-image-sizes.py"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": [],
            "presentation": {
                "reveal": "always",
                "panel": "shared",
                "clear": true
            },
            "detail": "Fill missing big/small variants of card_portraits & powers (upscale small->big, downscale big->small, 4x). Run 'Godot: Import assets' after."
        },
        {
            "label": "VFX: Pack sprite sheets",
            "type": "process",
            "command": "py",
            "args": [
                "${workspaceFolder}/tools/pack-atlases.py",
                "--character",
                "${input:character}",
                "--vfx"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": [],
            "presentation": {
                "reveal": "always",
                "panel": "shared",
                "clear": true
            },
            "detail": "Pack each <ModId>/images/vfx/raw/<name>/ folder into a power-of-two sprite sheet at images/vfx/sheets/<name>.png (tracked; prints hframes/vframes). Also runs the regular atlas pack."
        },
        {
            "label": "Images: Generate locked char-select silhouette",
            "type": "process",
            "command": "py",
            "args": [
                "${workspaceFolder}/tools/gen-locked-silhouette.py"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": [],
            "presentation": {
                "reveal": "always",
                "panel": "shared",
                "clear": true
            },
            "detail": "Regenerate char_select_char_name_locked.png as a flat silhouette of char_select_char_name.png (alpha shape, or background colour-key for full-bleed art)."
        },
        {
            "label": "dotnet build",
            "type": "process",
            "command": "dotnet",
            "args": [
                "build",
                "${input:csproj}"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": "$msCompile",
            "presentation": {
                "reveal": "always",
                "panel": "shared"
            },
            "detail": "dotnet build for the chosen character mod (prompts: Witch = TheWitch.csproj, Augur = TheAugur/TheAugur.csproj)."
        },
        {
            "label": "dotnet publish",
            "type": "process",
            "command": "dotnet",
            "args": [
                "publish",
                "${input:csproj}"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": "$msCompile",
            "presentation": {
                "reveal": "always",
                "panel": "shared"
            },
            "detail": "dotnet publish for the chosen character mod (prompts: Witch = TheWitch.csproj, Augur = TheAugur/TheAugur.csproj)."
        },
        {
            "label": "Workshop: Bundle",
            "type": "process",
            "command": "powershell",
            "args": [
                "-NoProfile",
                "-ExecutionPolicy",
                "Bypass",
                "-File",
                "${workspaceFolder}/tools/bundle-workshop.ps1",
                "-Character",
                "${input:character}"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": [],
            "presentation": {
                "reveal": "always",
                "panel": "shared",
                "clear": true
            },
            "detail": "dotnet publish (export .pck) + stage the chosen character mod into its workshop/content. Run before deploying; does NOT upload."
        },
        {
            "label": "Workshop: Deploy (upload to Steam)",
            "type": "process",
            "command": "powershell",
            "args": [
                "-NoProfile",
                "-ExecutionPolicy",
                "Bypass",
                "-File",
                "${workspaceFolder}/tools/bundle-workshop.ps1",
                "-Character",
                "${input:character}",
                "-SkipPublish",
                "-Upload",
                "-ChangeNote",
                "${input:changeNote}"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "dependsOn": "Workshop: Bundle",
            "problemMatcher": [],
            "presentation": {
                "reveal": "always",
                "panel": "shared",
                "clear": true
            },
            "detail": "Bundle, then upload to the Steam Workshop. Requires Steam running & logged in. First upload creates a new item and writes workshop/mod_id.txt (commit it). Prompts for the character mod."
        },
        {
            "label": "Card Data: Regen",
            "type": "process",
            "command": "node",
            "args": [
                "${workspaceFolder}/Docs/card-data/regen.js"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": [],
            "presentation": {
                "reveal": "always",
                "panel": "shared",
                "clear": true
            },
            "detail": "Rebuild Docs/card-data/cards.json from the card .cs files + localization, then regenerate pages/art-tracker.html."
        },
        {
            "label": "Card Designs: Serve",
            "type": "process",
            "command": "powershell",
            "args": [
                "-NoProfile",
                "-ExecutionPolicy",
                "Bypass",
                "-File",
                "${workspaceFolder}/tools/card-designs-serve.ps1"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "isBackground": true,
            "problemMatcher": [],
            "presentation": {
                "reveal": "always",
                "panel": "dedicated",
                "clear": true
            },
            "detail": "Start the card design page server (http://localhost:7820) and open it in the browser. Stop with 'Card Designs: Stop'."
        },
        {
            "label": "Art Tracker: Open",
            "type": "process",
            "command": "powershell",
            "args": [
                "-NoProfile",
                "-Command",
                "Start-Process '${workspaceFolder}/pages/art-tracker.html'"
            ],
            "problemMatcher": [],
            "presentation": {
                "reveal": "never"
            },
            "detail": "Open the local art tracker page (pages/art-tracker.html) in the default browser. Live copy: https://joytis.github.io/TheWicken/pages/art-tracker.html"
        },
        {
            "label": "Card Designs: Stop",
            "type": "process",
            "command": "powershell",
            "args": [
                "-NoProfile",
                "-ExecutionPolicy",
                "Bypass",
                "-File",
                "${workspaceFolder}/tools/card-designs-stop.ps1"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": [],
            "presentation": {
                "reveal": "always",
                "panel": "shared",
                "clear": true
            },
            "detail": "Stop the card design server (kills the node process on port 7820)."
        },
        {
            "label": "Analytics: Export web stats",
            "type": "process",
            "command": "powershell",
            "args": [
                "-NoProfile",
                "-ExecutionPolicy",
                "Bypass",
                "-File",
                "${workspaceFolder}/tools/analytics/analytics.ps1",
                "-Mode",
                "export"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": [],
            "presentation": {
                "reveal": "always",
                "panel": "shared",
                "clear": true
            },
            "detail": "Pull runs from Supabase and regenerate pages/analytics-data/*.json for the dashboard (same script CI runs nightly)."
        },
        {
            "label": "Analytics: Serve dashboard",
            "type": "process",
            "command": "powershell",
            "args": [
                "-NoProfile",
                "-Command",
                "Start-Process 'http://localhost:7821/pages/analytics.html'; py -m http.server 7821 --directory '${workspaceFolder}'"
            ],
            "isBackground": true,
            "problemMatcher": [],
            "presentation": {
                "reveal": "always",
                "panel": "dedicated",
                "clear": true
            },
            "detail": "Serve the repo on http://localhost:7821 and open the analytics dashboard (fetch needs http, not file://). Terminate the task to stop. Live copy: https://joytis.github.io/TheWicken/pages/analytics.html"
        },
        {
            "label": "Balance: Serve dashboard",
            "type": "process",
            "command": "powershell",
            "args": [
                "-NoProfile",
                "-Command",
                "node '${workspaceFolder}/Docs/card-data/balance.js'; Start-Process 'http://localhost:7822/Docs/balance-dashboard.html'; py -m http.server 7822 --directory '${workspaceFolder}'"
            ],
            "isBackground": true,
            "problemMatcher": [],
            "presentation": {
                "reveal": "always",
                "panel": "dedicated",
                "clear": true
            },
            "detail": "Rebuild Docs/balance-dashboard.html from Docs/card-data/*.json (Witch / Augur vs base classes damage/block per card + per energy; focus character switchable on the page), serve the repo on http://localhost:7822 and open it. Terminate the task to stop. Re-run after card edits + 'Card Data: Regen'."
        }
    ],
    "inputs": [
        {
            "id": "character",
            "type": "pickString",
            "description": "Which character mod?",
            "options": [
                {
                    "label": "Witch (TheWitch)",
                    "value": "Witch"
                },
                {
                    "label": "Augur (TheAugur)",
                    "value": "Augur"
                }
            ],
            "default": "Witch"
        },
        {
            "id": "csproj",
            "type": "pickString",
            "description": "Which character mod project?",
            "options": [
                {
                    "label": "Witch (TheWitch/TheWitch.csproj)",
                    "value": "TheWitch/TheWitch.csproj"
                },
                {
                    "label": "Augur (TheAugur/TheAugur.csproj)",
                    "value": "TheAugur/TheAugur.csproj"
                },
                {
                    "label": "BirdDebug (BirdDebug/BirdDebug.csproj, dev-only debug flags)",
                    "value": "BirdDebug/BirdDebug.csproj"
                }
            ],
            "default": "TheWitch/TheWitch.csproj"
        },
        {
            "id": "playerCount",
            "type": "promptString",
            "description": "Total players to launch (1 host + rest clients)",
            "default": "2"
        },
        {
            "id": "changeNote",
            "type": "promptString",
            "description": "Steam Workshop change note for this upload (blank = leave unchanged)",
            "default": ""
        },
        {
            "id": "build.none",
            "type": "pickString",
            "description": "Build step before launching?",
            "options": [
                {
                    "label": "None (use what's deployed)",
                    "value": "none"
                },
                {
                    "label": "Build (dotnet build: dll + json)",
                    "value": "build"
                },
                {
                    "label": "Publish (dotnet publish: dll + .pck assets)",
                    "value": "publish"
                }
            ],
            "default": "none"
        },
        {
