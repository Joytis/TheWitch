<Project Sdk="Microsoft.NET.Sdk">

    <!--
      Syncs a Workshop item's gallery (additional preview images + YouTube videos) to a
      marketing manifest. Driven by tools/bundle-workshop.ps1 -UpdateMarketing; see Program.cs.
      Deliberately NOT in TheWicken.slnx: it is a release tool, not part of the mod build.

      Steamworks.NET is pinned to the version MegaCrit's ModUploader ships (15.0.1) so the
      steam_api64.dll copied from tools/ModUploader-win-x64/ is guaranteed to match its bindings.
    -->
    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net9.0</TargetFramework>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <RuntimeIdentifier>win-x64</RuntimeIdentifier>
        <PlatformTarget>x64</PlatformTarget>
        <SelfContained>false</SelfContained>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Steamworks.NET" Version="15.0.1" />
    </ItemGroup>

    <ItemGroup>
        <!-- steam_appid.txt (2868840 = Slay the Spire 2) is read from the working directory at
             SteamAPI.Init; Program.cs switches to the exe folder, so both ship beside the exe. -->
        <None Include="..\ModUploader-win-x64\steam_api64.dll" CopyToOutputDirectory="PreserveNewest" Visible="false" />
        <None Include="..\ModUploader-win-x64\steam_appid.txt" CopyToOutputDirectory="PreserveNewest" Visible="false" />
    </ItemGroup>

</Project>
